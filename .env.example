# Aplicação local. Copiar para .env; nunca preencher segredos no Git.
NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
WEB_PORT=5173
LOG_LEVEL=info

# Lagom DRP sandbox; rotas são relativas à raiz do host, não a /api.
LAGOM_API_BASE_URL=https://beta-api-sandbox.lagomtech.com.br
LAGOM_ORGANIZATION=
LAGOM_TOKEN=
LAGOM_TIMEOUT_MS=30000

# Bling API v3 — endpoints oficiais.
BLING_API_BASE_URL=https://api.bling.com.br/Api/v3
BLING_OAUTH_AUTHORIZE_URL=https://www.bling.com.br/Api/v3/oauth/authorize
BLING_OAUTH_TOKEN_URL=https://api.bling.com.br/Api/v3/oauth/token
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REDIRECT_URI=

# Persistência local; mudar credenciais antes de qualquer ambiente partilhado.
DATABASE_URL=postgresql://app:change_me@localhost:5432/lagom_bling
REDIS_URL=redis://localhost:6379
TOKEN_ENCRYPTION_KEY=

# Guardas de segurança — manter false até implementação, homologação e autorização.
SCHEDULER_ENABLED=false
WRITE_ENABLED=false
LAGOM_TO_BLING_ENABLED=false
BLING_TO_LAGOM_ENABLED=false
DRY_RUN_DEFAULT=true

# Horários definidos pelo projecto; timezone local da agenda.
OUTBOUND_CRON=*/10 * * * *
INBOUND_CRON=0 20 * * *
SCHEDULER_TIMEZONE=America/Sao_Paulo

# Limites de operação (Bling: quota global por conta; iniciar com margem).
BLING_RATE_LIMIT_PER_SECOND=2
MAX_RETRY_ATTEMPTS=5
REQUEST_TIMEOUT_MS=30000

# PostgreSQL no Docker Compose (apenas desenvolvimento local).
POSTGRES_DB=lagom_bling
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# Habilitar após preencher credenciais, callback e chaves.
BLING_OAUTH_ENABLED=false
ADMIN_API_TOKEN=
# TOKEN_ENCRYPTION_KEY: 64 caracteres hexadecimais (32 bytes); manter backup seguro.
